# Optional. config.py already has ISD's Sheet links; anything here overrides them.
# Locally: copy this file to .streamlit/secrets.toml.
# On Streamlit Cloud: App -> Settings -> Secrets, paste the [sheets] block.
#
# Link format for one tab (the gid is in the Sheet's address bar when that tab is open):
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<TAB_GID>
# The Sheet must be shared as "Anyone with the link: Viewer".

[sheets]
dogs = "https://docs.google.com/spreadsheets/d/1dn6-9QMwlQ5c0LjPRj3ccA8jU-TPiEVQ0wwHkWJNUWY/export?format=csv&gid=914704615"
faq = "https://docs.google.com/spreadsheets/d/1dn6-9QMwlQ5c0LjPRj3ccA8jU-TPiEVQ0wwHkWJNUWY/export?format=csv&gid=1304248444"
events = "https://docs.google.com/spreadsheets/d/1dn6-9QMwlQ5c0LjPRj3ccA8jU-TPiEVQ0wwHkWJNUWY/export?format=csv&gid=305217368"
sponsor_tiers = "https://docs.google.com/spreadsheets/d/1dn6-9QMwlQ5c0LjPRj3ccA8jU-TPiEVQ0wwHkWJNUWY/export?format=csv&gid=840687152"
site_text = "https://docs.google.com/spreadsheets/d/1dn6-9QMwlQ5c0LjPRj3ccA8jU-TPiEVQ0wwHkWJNUWY/export?format=csv&gid=1534344510"
