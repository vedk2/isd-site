# Copy this file to .streamlit/secrets.toml to run locally with the live Google Sheet,
# or paste the same text into Streamlit Community Cloud: App -> Settings -> Secrets.
#
# Each value is the "Publish to web -> CSV" link for one tab of ISD's Google Sheet.
# If a link is blank or broken, the site quietly uses the copy in backup/ instead.

[sheets]
dogs = "https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv"
faq = "https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=111111111&single=true&output=csv"
events = "https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=222222222&single=true&output=csv"
sponsor_tiers = "https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=333333333&single=true&output=csv"
site_text = "https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=444444444&single=true&output=csv"
